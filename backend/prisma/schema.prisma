generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum PersonRole {
  CUSTOMER
  SUPPLIER
  CARRIER
  SERVICE_PROVIDER
}

enum PersonType {
  PF
  PJ
}

enum PersonContactEventType {
  PHONE_CREATED
  EMAIL_CREATED
  PHONE_PRIMARY_CHANGED
  EMAIL_PRIMARY_CHANGED
}

enum ProductCategory {
  PART
  RESALE_GOOD
}

enum ProductStockMovementType {
  MANUAL_ENTRY
  MANUAL_ADJUSTMENT
  DEFECTIVE_CLASSIFIED
  DEFECTIVE_RETURNED
  DEFECTIVE_DISCARDED
  SERVICE_ORDER_APPLIED
  SERVICE_ORDER_REVERSED
}

enum ProductStockMovementOrigin {
  MANUAL
  SERVICE_ORDER
}

model Person {
  id                           Int                    @id @default(autoincrement())
  publicId                     String                 @unique @default(uuid()) @map("public_id") @db.Char(36)
  personType                   PersonType             @map("person_type")
  name                         String                 @db.VarChar(191)
  document                     String?                @unique @db.VarChar(14)
  tradeName                    String?                @map("trade_name") @db.Text
  stateRegistration            String?                @map("state_registration") @db.Text
  municipalRegistration        String?                @map("municipal_registration") @db.Text
  observations                 String?                @db.Text
  isActive                     Boolean                @default(true) @map("is_active")
  createdAt                    DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  roles                        PersonRoleAssignment[]
  phones                       PersonPhone[]
  emails                       PersonEmail[]
  contactEvents                PersonContactEvent[]
  address                      PersonAddress?
  primaryContactFor            Person[]               @relation("PersonPrimaryContact")
  primaryContact               Person?                @relation("PersonPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  primaryContactId             Int?                   @map("primary_contact_id")
  equipment                    Equipment[]
  previousOwnershipEvents      EquipmentOwnership[]   @relation("PreviousEquipmentOwner")
  newOwnershipEvents           EquipmentOwnership[]   @relation("NewEquipmentOwner")
  serviceOrderCustomers        ServiceOrder[]         @relation("ServiceOrderCustomer")
  serviceOrderOpeningCustomers ServiceOrderOpening[]  @relation("OpeningCustomer")

  @@index([name])
  @@map("people")
}

model PersonRoleAssignment {
  personId Int        @map("person_id")
  role     PersonRole
  person   Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([personId, role])
  @@map("person_roles")
}

model PersonPhone {
  id        Int                  @id @default(autoincrement())
  publicId  String               @unique @default(uuid()) @map("public_id") @db.Char(36)
  personId  Int                  @map("person_id")
  label     String?              @db.VarChar(80)
  number    String               @db.VarChar(32)
  isPrimary Boolean              @default(false) @map("is_primary")
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  person    Person               @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events    PersonContactEvent[]

  @@index([personId, isPrimary])
  @@map("person_phones")
}

model PersonEmail {
  id        Int                  @id @default(autoincrement())
  publicId  String               @unique @default(uuid()) @map("public_id") @db.Char(36)
  personId  Int                  @map("person_id")
  label     String?              @db.VarChar(80)
  address   String               @db.VarChar(254)
  isPrimary Boolean              @default(false) @map("is_primary")
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  person    Person               @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events    PersonContactEvent[]

  @@unique([personId, address])
  @@index([personId, isPrimary])
  @@map("person_emails")
}

model PersonContactEvent {
  id                      Int                    @id @default(autoincrement())
  personId                Int                    @map("person_id")
  eventType               PersonContactEventType @map("event_type")
  phoneId                 Int?                   @map("phone_id")
  emailId                 Int?                   @map("email_id")
  previousContactPublicId String?                @map("previous_contact_public_id") @db.Char(36)
  previousValue           String?                @map("previous_value") @db.VarChar(254)
  newValue                String                 @map("new_value") @db.VarChar(254)
  occurredAt              DateTime               @default(now()) @map("occurred_at") @db.DateTime(3)
  userId                  Int?                   @map("user_id")
  person                  Person                 @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  phone                   PersonPhone?           @relation(fields: [phoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  email                   PersonEmail?           @relation(fields: [emailId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([personId, occurredAt])
  @@index([userId])
  @@map("person_contact_events")
}

model User {
  id                            Int                       @id @default(autoincrement())
  publicId                      String                    @unique @default(uuid()) @map("public_id") @db.Char(36)
  username                      String                    @unique @db.VarChar(50)
  passwordHash                  String                    @map("password_hash") @db.VarChar(255)
  isAdmin                       Boolean                   @default(false) @map("is_admin")
  isActive                      Boolean                   @default(true) @map("is_active")
  consecutiveFailedLoginCount   Int                       @default(0) @map("consecutive_failed_login_count")
  lastLoginAt                   DateTime?                 @map("last_login_at") @db.DateTime(3)
  inactivatedAt                 DateTime?                 @map("inactivated_at") @db.DateTime(3)
  createdAt                     DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                     DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  permissions                   UserPermission[]          @relation("PermissionRecipient")
  permissionsGranted            UserPermission[]          @relation("PermissionGrantor")
  sessions                      UserSession[]
  auditActions                  AdminAuditLog[]           @relation("AuditActor")
  auditTargets                  AdminAuditLog[]           @relation("AuditTarget")
  contactEvents                 PersonContactEvent[]
  initiatedServiceOrderOpenings ServiceOrderOpening[]     @relation("OpeningInitiator")
  activeServiceOrderOpening     ServiceOrderOpening?      @relation("OpeningActiveUser")
  requestedOpeningTransfers     ServiceOrderOpening[]     @relation("OpeningTransferRequester")
  createdServiceOrders          ServiceOrder[]            @relation("ServiceOrderCreator")
  serviceOrderAssignments       ServiceOrderAssignment[]  @relation("AssignmentUser")
  serviceOrderAssignmentsMade   ServiceOrderAssignment[]  @relation("AssignmentActor")
  serviceOrderEvents            ServiceOrderEvent[]       @relation("ServiceOrderEventActor")
  serviceOrderNotes             ServiceOrderNote[]        @relation("ServiceOrderNoteAuthor")
  initiatedServiceOrderEvents   ServiceOrderEvent[]       @relation("ServiceOrderEventInitiator")
  equipmentOwnershipChanges     EquipmentOwnership[]      @relation("EquipmentOwnershipActor")
  createdCatalogServices        ServiceCatalog[]          @relation("ServiceCatalogCreator")
  updatedCatalogServices        ServiceCatalog[]          @relation("ServiceCatalogUpdater")
  createdProducts               Product[]                 @relation("ProductCreator")
  updatedProducts               Product[]                 @relation("ProductUpdater")
  productStockMovements         ProductStockMovement[]
  createdBudgetItems            ServiceOrderBudgetItem[]  @relation("BudgetItemCreator")
  updatedBudgetItems            ServiceOrderBudgetItem[]  @relation("BudgetItemUpdater")
  removedBudgetItems            ServiceOrderBudgetItem[]  @relation("BudgetItemRemover")
  heldServiceOrderEditControls  ServiceOrderEditControl[]

  @@index([isAdmin, isActive])
  @@map("users")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(191)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  users       UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId          Int        @map("user_id")
  permissionId    Int        @map("permission_id")
  grantedAt       DateTime   @default(now()) @map("granted_at") @db.DateTime(3)
  grantedByUserId Int?       @map("granted_by_user_id")
  user            User       @relation("PermissionRecipient", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       User?      @relation("PermissionGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
  @@map("user_permissions")
}

model UserSession {
  id                       Int                       @id @default(autoincrement())
  userId                   Int                       @map("user_id")
  tokenHash                String                    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash            String                    @map("csrf_token_hash") @db.Char(64)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt               DateTime                  @map("last_used_at") @db.DateTime(3)
  expiresAt                DateTime                  @map("expires_at") @db.DateTime(3)
  revokedAt                DateTime?                 @map("revoked_at") @db.DateTime(3)
  userAgent                String?                   @map("user_agent") @db.Text
  ipAddress                String?                   @map("ip_address") @db.VarChar(45)
  origin                   String?                   @db.VarChar(2048)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrderEditControls ServiceOrderEditControl[]

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model PreAuthCsrfContext {
  id             Int       @id @default(autoincrement())
  identifierHash String    @unique @map("identifier_hash") @db.Char(64)
  csrfTokenHash  String    @map("csrf_token_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  usedAt         DateTime? @map("used_at") @db.DateTime(3)
  userAgent      String?   @map("user_agent") @db.Text
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  origin         String?   @db.VarChar(2048)

  @@index([expiresAt])
  @@map("pre_auth_csrf_contexts")
}

model AdminAuditLog {
  id                Int      @id @default(autoincrement())
  eventCode         String   @map("event_code") @db.VarChar(80)
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  actorUserId       Int?     @map("actor_user_id")
  targetUserId      Int?     @map("target_user_id")
  attemptedUsername String?  @map("attempted_username") @db.VarChar(50)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  origin            String?  @db.VarChar(2048)
  userAgent         String?  @map("user_agent") @db.Text
  detailsJson       Json?    @map("details_json")
  actor             User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  target            User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([eventCode, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetUserId, occurredAt])
  @@index([attemptedUsername, occurredAt])
  @@map("admin_audit_log")
}

model ServiceCatalog {
  id              Int                      @id @default(autoincrement())
  publicId        String                   @unique @default(uuid()) @map("public_id") @db.Char(36)
  name            String                   @db.VarChar(120)
  normalizedName  String                   @unique @map("normalized_name") @db.VarChar(191)
  defaultPrice    Decimal                  @map("default_price") @db.Decimal(15, 2)
  isActive        Boolean                  @default(true) @map("is_active")
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId Int                      @map("created_by_user_id")
  updatedByUserId Int                      @map("updated_by_user_id")
  createdBy       User                     @relation("ServiceCatalogCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy       User                     @relation("ServiceCatalogUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budgetItems     ServiceOrderBudgetItem[]

  @@index([isActive, name, id])
  @@index([name, id])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("service_catalog")
}

model Product {
  id                      Int                      @id @default(autoincrement())
  publicId                String                   @unique @default(uuid()) @map("public_id") @db.Char(36)
  internalCode            String?                  @unique @map("internal_code") @db.VarChar(64)
  description             String                   @db.VarChar(255)
  category                ProductCategory
  salePrice               Decimal?                 @map("sale_price") @db.Decimal(15, 2)
  acquisitionCost         Decimal?                 @map("acquisition_cost") @db.Decimal(15, 2)
  isActive                Boolean                  @default(true) @map("is_active")
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId         Int                      @map("created_by_user_id")
  updatedByUserId         Int                      @map("updated_by_user_id")
  createdBy               User                     @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy               User                     @relation("ProductUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockMovements          ProductStockMovement[]
  serviceOrderBudgetItems ServiceOrderBudgetItem[]

  @@index([isActive, category, description, id])
  @@index([description, id])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("products")
}

model ProductStockMovement {
  id               Int                        @id @default(autoincrement())
  publicId         String                     @unique @default(uuid()) @map("public_id") @db.Char(36)
  productId        Int                        @map("product_id")
  type             ProductStockMovementType
  origin           ProductStockMovementOrigin @default(MANUAL)
  totalDelta       Int                        @default(0) @map("total_delta")
  appliedDelta     Int                        @default(0) @map("applied_delta")
  defectiveDelta   Int                        @default(0) @map("defective_delta")
  serviceOrderId   Int?                       @map("service_order_id")
  budgetItemId     Int?                       @map("budget_item_id")
  sourceMovementId Int?                       @map("source_movement_id")
  unitCostSnapshot Decimal?                   @map("unit_cost_snapshot") @db.Decimal(15, 2)
  actorUserId      Int                        @map("actor_user_id")
  occurredAt       DateTime                   @default(now()) @map("occurred_at") @db.DateTime(3)
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrder     ServiceOrder?              @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budgetItem       ServiceOrderBudgetItem?    @relation(fields: [budgetItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceMovement   ProductStockMovement?      @relation("StockMovementReversals", fields: [sourceMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversals        ProductStockMovement[]     @relation("StockMovementReversals")
  actor            User                       @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, occurredAt, id])
  @@index([actorUserId, occurredAt])
  @@index([serviceOrderId, budgetItemId, occurredAt, id], map: "stock_movement_order_item_time_idx")
  @@index([sourceMovementId, occurredAt, id], map: "stock_movement_source_time_idx")
  @@map("product_stock_movements")
}

// Technical mutex rows serialize cross-table name checks through the surrounding transaction.
model ServiceOrderBudgetNameLock {
  normalizedName String @id @map("normalized_name") @db.VarChar(255)

  @@map("service_order_budget_name_locks")
}

model PersonAddress {
  id         Int      @id @default(autoincrement())
  personId   Int      @unique @map("person_id")
  postalCode String?  @map("postal_code") @db.VarChar(16)
  street     String?  @db.VarChar(191)
  number     String?  @db.VarChar(32)
  complement String?  @db.VarChar(100)
  district   String?  @db.VarChar(100)
  city       String?  @db.VarChar(100)
  state      String?  @db.Char(2)
  country    String   @default("BR") @db.Char(2)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("person_addresses")
}

model EquipmentType {
  id        Int         @id @default(autoincrement())
  publicId  String      @unique @default(uuid()) @map("public_id") @db.Char(36)
  name      String      @unique @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  equipment Equipment[]

  @@map("equipment_types")
}

model EquipmentBrand {
  id        Int         @id @default(autoincrement())
  publicId  String      @unique @default(uuid()) @map("public_id") @db.Char(36)
  name      String      @unique @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  equipment Equipment[]

  @@map("equipment_brands")
}

model Equipment {
  id                   Int                   @id @default(autoincrement())
  publicId             String                @unique @default(uuid()) @map("public_id") @db.Char(36)
  ownerId              Int                   @map("owner_id")
  typeId               Int                   @map("type_id")
  brandId              Int                   @map("brand_id")
  model                String                @db.VarChar(191)
  isActive             Boolean               @default(true) @map("is_active")
  serialNumber         String?               @map("serial_number") @db.VarChar(191)
  createdAt            DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  owner                Person                @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type                 EquipmentType         @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand                EquipmentBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownershipEvents      EquipmentOwnership[]
  serviceOrders        ServiceOrder[]
  serviceOrderOpenings ServiceOrderOpening[]

  @@index([ownerId])
  @@index([serialNumber])
  @@map("equipment")
}

model EquipmentOwnership {
  id              Int           @id @default(autoincrement())
  equipmentId     Int           @map("equipment_id")
  previousOwnerId Int?          @map("previous_owner_id")
  newOwnerId      Int           @map("new_owner_id")
  serviceOrderId  Int?          @map("service_order_id")
  changedByUserId Int?          @map("changed_by_user_id")
  changedAt       DateTime      @default(now()) @map("changed_at") @db.DateTime(3)
  equipment       Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousOwner   Person?       @relation("PreviousEquipmentOwner", fields: [previousOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  newOwner        Person        @relation("NewEquipmentOwner", fields: [newOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy       User?         @relation("EquipmentOwnershipActor", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipmentId, changedAt])
  @@index([serviceOrderId])
  @@index([changedByUserId, changedAt])
  @@map("equipment_ownership_events")
}

enum ServiceOrderOpeningStatus {
  IN_PROGRESS
  CONFIRMED
  CANCELED

  @@map("service_order_opening_status")
}

enum SerialIdentificationStatus {
  IDENTIFIED
  NOT_IDENTIFIED

  @@map("serial_identification_status")
}

enum ServiceOrderNumberAllocationStatus {
  RESERVED
  CONFIRMED
  CONSUMED
  RELEASED

  @@map("service_order_number_allocation_status")
}

enum ServiceOrderMacroStatus {
  OPEN @map("ABERTA")

  @@map("service_order_macro_status")
}

enum ServiceOrderBudgetItemType {
  SERVICE_LABOR
  MANUAL_PART
  STOCK_PART

  @@map("service_order_budget_item_type")
}

enum ServiceOrderBudgetItemOrigin {
  REGISTERED
  MANUAL
  PRODUCT_CATALOG

  @@map("service_order_budget_item_origin")
}

enum ServiceOrderOperationalSituation {
  TRIAGE                        @map("TRIAGEM")
  AWAITING_EVALUATION_BUDGET    @map("AGUARDANDO AVALIAÇÃO/ORÇAMENTO")
  AWAITING_BUDGET_APPROVAL      @map("AGUARDANDO APROVAÇÃO DO ORÇAMENTO")
  REPAIR_AUTHORIZED             @map("AUTORIZADO REPARO")
  AWAITING_PART_PURCHASE        @map("AGUARDANDO COMPRA DE PEÇA")
  AWAITING_PART_ARRIVAL         @map("AGUARDANDO CHEGADA DE PEÇA")
  READY_TO_NOTIFY_CUSTOMER      @map("PRONTO AVISAR CLIENTE")
  READY_CUSTOMER_NOTIFIED       @map("PRONTO CLIENTE AVISADO")
  NOT_AUTHORIZED_REASSEMBLE     @map("NÃO AUTORIZADO - REMONTAR EQUIPAMENTO")
  NOT_AUTHORIZED_READY_DELIVERY @map("NÃO AUTORIZADO - PRONTO PRA ENTREGA")

  @@map("service_order_operational_situation")
}

model ServiceOrderNumberControl {
  id                    Int      @id
  nextNumber            BigInt   @default(1) @map("next_number")
  highestReservedNumber BigInt   @default(0) @map("highest_reserved_number")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("service_order_number_control")
}

model ServiceOrderNumberAllocation {
  numberValue BigInt                             @id @map("number_value")
  status      ServiceOrderNumberAllocationStatus
  openingId   Int?                               @unique @map("opening_id")
  createdAt   DateTime                           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                           @updatedAt @map("updated_at") @db.DateTime(3)

  opening      ServiceOrderOpening? @relation(fields: [openingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrder ServiceOrder?

  @@index([status, updatedAt])
  @@map("service_order_number_allocations")
}

model ServiceOrderOpening {
  id                        Int                       @id @default(autoincrement())
  publicId                  String                    @unique @default(uuid()) @map("public_id") @db.Char(36)
  status                    ServiceOrderOpeningStatus @default(IN_PROGRESS)
  initiatedByUserId         Int                       @map("initiated_by_user_id")
  activeForUserId           Int?                      @unique @map("active_for_user_id")
  attemptedNumberValue      BigInt                    @map("attempted_number_value")
  customerId                Int?                      @map("customer_id")
  equipmentId               Int?                      @map("equipment_id")
  equipmentDraftJson        Json?                     @map("equipment_draft_json")
  equipmentDraftVersion     Int?                      @map("equipment_draft_version")
  transferRequested         Boolean                   @default(false) @map("transfer_requested")
  transferRequestedByUserId Int?                      @map("transfer_requested_by_user_id")
  transferRequestedAt       DateTime?                 @map("transfer_requested_at") @db.DateTime(3)
  complaint                 String?                   @db.Text
  resumedAt                 DateTime?                 @map("resumed_at") @db.DateTime(3)
  confirmedAt               DateTime?                 @map("confirmed_at") @db.DateTime(3)
  canceledAt                DateTime?                 @map("canceled_at") @db.DateTime(3)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  initiator         User                          @relation("OpeningInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeForUser     User?                         @relation("OpeningActiveUser", fields: [activeForUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transferRequester User?                         @relation("OpeningTransferRequester", fields: [transferRequestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer          Person?                       @relation("OpeningCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipment         Equipment?                    @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  numberAllocation  ServiceOrderNumberAllocation?
  serviceOrder      ServiceOrder?
  events            ServiceOrderEvent[]

  @@index([initiatedByUserId, status, updatedAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([equipmentId])
  @@index([attemptedNumberValue])
  @@map("service_order_openings")
}

model ServiceOrder {
  id                                     Int                              @id @default(autoincrement())
  publicId                               String                           @unique @default(uuid()) @map("public_id") @db.Char(36)
  openingId                              Int                              @unique @map("opening_id")
  numberValue                            BigInt                           @unique @map("number_value")
  customerId                             Int                              @map("customer_id")
  equipmentId                            Int                              @map("equipment_id")
  createdByUserId                        Int                              @map("created_by_user_id")
  macroStatus                            ServiceOrderMacroStatus          @default(OPEN) @map("macro_status")
  operationalSituation                   ServiceOrderOperationalSituation @default(TRIAGE) @map("operational_situation")
  complaint                              String?                          @db.Text
  intakeObservations                     String?                          @map("intake_observations") @db.Text
  newEquipmentSerialIdentificationStatus SerialIdentificationStatus?      @map("new_equipment_serial_identification_status")
  customerSnapshotJson                   Json                             @map("customer_snapshot_json")
  equipmentSnapshotJson                  Json                             @map("equipment_snapshot_json")
  snapshotVersion                        Int                              @default(1) @map("snapshot_version")
  snapshotCapturedAt                     DateTime                         @map("snapshot_captured_at") @db.DateTime(3)
  openedAt                               DateTime                         @default(now()) @map("opened_at") @db.DateTime(3)
  createdAt                              DateTime                         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                              DateTime                         @updatedAt @map("updated_at") @db.DateTime(3)

  opening          ServiceOrderOpening          @relation(fields: [openingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  numberAllocation ServiceOrderNumberAllocation @relation(fields: [numberValue], references: [numberValue], onDelete: Restrict, onUpdate: Cascade)
  customer         Person                       @relation("ServiceOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipment        Equipment                    @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User                         @relation("ServiceOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments      ServiceOrderAssignment[]
  events           ServiceOrderEvent[]
  notes            ServiceOrderNote[]
  ownershipEvents  EquipmentOwnership[]
  budgetItems      ServiceOrderBudgetItem[]
  stockMovements   ProductStockMovement[]
  editControl      ServiceOrderEditControl?

  @@index([macroStatus, operationalSituation, openedAt])
  @@index([customerId, openedAt])
  @@index([equipmentId, openedAt])
  @@index([createdByUserId, openedAt])
  @@map("service_orders")
}

model ServiceOrderAssignment {
  serviceOrderId   Int      @map("service_order_id")
  userId           Int      @map("user_id")
  assignedByUserId Int      @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User         @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy   User         @relation("AssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([serviceOrderId, userId])
  @@index([userId, serviceOrderId])
  @@index([assignedByUserId, assignedAt])
  @@map("service_order_assignments")
}

model ServiceOrderEvent {
  id               Int      @id @default(autoincrement())
  serviceOrderId   Int?     @map("service_order_id")
  openingId        Int?     @map("opening_id")
  actorUserId      Int      @map("actor_user_id")
  initiatingUserId Int?     @map("initiating_user_id")
  eventType        String   @map("event_type") @db.VarChar(80)
  numberValue      BigInt   @map("number_value")
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  payload          Json?    @map("payload_json")

  serviceOrder   ServiceOrder?        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  opening        ServiceOrderOpening? @relation(fields: [openingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor          User                 @relation("ServiceOrderEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  initiatingUser User?                @relation("ServiceOrderEventInitiator", fields: [initiatingUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([serviceOrderId, occurredAt])
  @@index([openingId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("service_order_events")
}

model ServiceOrderNote {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @default(uuid()) @map("public_id") @db.Char(36)
  serviceOrderId Int      @map("service_order_id")
  authorUserId   Int      @map("author_user_id")
  text           String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author       User         @relation("ServiceOrderNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([serviceOrderId, createdAt, id])
  @@index([authorUserId])
  @@map("service_order_notes")
}

model ServiceOrderBudgetItem {
  id                    Int                          @id @default(autoincrement())
  publicId              String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  serviceOrderId        Int                          @map("service_order_id")
  itemType              ServiceOrderBudgetItemType   @map("item_type")
  origin                ServiceOrderBudgetItemOrigin
  serviceCatalogId      Int?                         @map("service_catalog_id")
  productId             Int?                         @map("product_id")
  description           String                       @db.VarChar(255)
  normalizedDescription String?                      @map("normalized_description") @db.VarChar(255)
  quantity              Int                          @default(1)
  unitPrice             Decimal                      @map("unit_price") @db.Decimal(15, 2)
  unitCost              Decimal?                     @map("unit_cost") @db.Decimal(15, 2)
  version               Int                          @default(1)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId       Int                          @map("created_by_user_id")
  updatedByUserId       Int                          @map("updated_by_user_id")
  removedAt             DateTime?                    @map("removed_at") @db.DateTime(3)
  removedByUserId       Int?                         @map("removed_by_user_id")
  serviceOrder          ServiceOrder                 @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceCatalog        ServiceCatalog?              @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product               Product?                     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy             User                         @relation("BudgetItemCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy             User                         @relation("BudgetItemUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedBy             User?                        @relation("BudgetItemRemover", fields: [removedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockMovements        ProductStockMovement[]

  @@index([serviceOrderId, removedAt, id])
  @@index([serviceCatalogId])
  @@index([productId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([removedByUserId])
  @@map("service_order_budget_items")
}

model ServiceOrderEditControl {
  id               Int          @id @default(autoincrement())
  serviceOrderId   Int          @unique @map("service_order_id")
  holderUserId     Int?         @map("holder_user_id")
  holderSessionId  Int?         @map("holder_session_id")
  contextTokenHash String?      @map("context_token_hash") @db.Char(64)
  leaseVersion     Int          @default(0) @map("lease_version")
  lastHeartbeatAt  DateTime     @map("last_heartbeat_at") @db.DateTime(3)
  expiresAt        DateTime     @map("expires_at") @db.DateTime(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  holder           User?        @relation(fields: [holderUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  holderSession    UserSession? @relation(fields: [holderSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([holderUserId, expiresAt])
  @@index([holderSessionId, expiresAt])
  @@index([expiresAt])
  @@map("service_order_edit_controls")
}
