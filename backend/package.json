{
  "name": "sistema-gestor-os-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "auth:bootstrap-admin": "npm run build && node dist/scripts/bootstrap-admin.js",
    "auth:seed-permissions": "npm run build && node dist/scripts/seed-permissions.js",
    "equipment:seed-unspecified-brand": "npm run build && node dist/scripts/seed-unspecified-brand.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:safe": "node scripts/prisma-safe.mjs",
    "test:services": "npm run build && node --test test/services.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@prisma/adapter-mariadb@7.10.0": {
      "mariadb": "3.4.7"
    }
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "argon2@0.45.1": true
  }
}
